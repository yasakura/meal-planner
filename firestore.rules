rules_version = '2';

// Meal Planner — Security Rules Firestore (projet dev meal-planner-dev-c9e0d).
// FR-6 : les recettes vivent dans une collection plate `recipes/{id}`.
// Décision (roadmap iter 1) : accès réservé à tout utilisateur authentifié, sans
// scoping par propriétaire pour l'instant (app foyer, differé). À resserrer en
// `request.auth.uid == resource.data.ownerId` quand le multi-compte l'exigera.
service cloud.firestore {
  match /databases/{database}/documents {
    match /recipes/{recipeId} {
      allow read, write: if request.auth != null;
    }
  }
}
