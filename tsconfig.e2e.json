{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    // PAS `vitest/globals`, contrairement au tsconfig racine : `expect` et `test` viennent ici
    // de `@playwright/test`, et les globales Vitest les masqueraient avec des signatures qui
    // ne sont pas les bonnes.
    "types": ["node"],
    "outDir": "./.tsbuild/e2e"
  },
  "include": ["e2e", "playwright.config.ts"]
}
